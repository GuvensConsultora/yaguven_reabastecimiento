<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sucursal: cada cuántos días le llega mercadería (lo usa el mín/máx sugerido) -->
    <record id="view_warehouse_form_yaguven_reabast" model="ir.ui.view">
        <field name="name">stock.warehouse.form.yaguven.reabast</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <field name="code" position="after">
                <field name="yaguven_dias_entre_llegadas"/>
            </field>
        </field>
    </record>

    <!-- Reabastecimiento: sugeridos al lado del mín/máx real, para comparar antes de aplicar -->
    <record id="view_orderpoint_tree_yaguven_sugerido" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.list.yaguven.sugerido</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="inherit_id" ref="stock.view_warehouse_orderpoint_tree_editable"/>
        <field name="arch" type="xml">
            <field name="product_max_qty" position="after">
                <field name="yaguven_venta_ventana" string="Vendido" optional="show" width="60"/>
                <field name="yaguven_min_sugerido" string="Mín sug." optional="show" width="60"/>
                <field name="yaguven_max_sugerido" string="Máx sug." optional="show" width="60"/>
                <field name="yaguven_sugerido_fecha" optional="hide"/>
                <field name="yaguven_sugerido_fuente" optional="hide"/>
            </field>
        </field>
    </record>

    <!-- «Aplicar sugerido» sobre las reglas seleccionadas (menú Acciones de la lista) -->
    <record id="action_orderpoint_aplicar_sugerido" model="ir.actions.server">
        <field name="name">Aplicar mín/máx sugerido</field>
        <field name="model_id" ref="stock.model_stock_warehouse_orderpoint"/>
        <field name="binding_model_id" ref="stock.model_stock_warehouse_orderpoint"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('yaguven_reabastecimiento.group_reabast_supervisor'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_yaguven_aplicar_sugerido()</field>
    </record>
</odoo>
